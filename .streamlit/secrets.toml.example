# ─────────────────────────────────────────────────────────────────────────────
# RFQ Sender runtime secrets — TEMPLATE. Copy to .streamlit/secrets.toml and
# fill in. The real file is git-ignored; never commit it.
#
#   Local:  this file at .streamlit/secrets.toml
#   Render: paste the WHOLE filled-in file into the STREAMLIT_SECRETS_TOML
#           environment variable (the file is not in the repo there).
#
# If .streamlit/secrets.toml exists it wins; STREAMLIT_SECRETS_TOML is only
# read when the file is absent. (The folder name is historical — Streamlit
# itself is no longer used.)
#
# JWT_SECRET_KEY does NOT go here — see .env.example.
# ─────────────────────────────────────────────────────────────────────────────

# Microsoft Graph — creates the Outlook drafts. REQUIRED for drafting.
# Azure portal → App registrations → your app. The app needs the *application*
# permission Mail.ReadWrite (admin-consented), because drafts are written into
# each user's own mailbox (the email they log in with).
[azure]
tenant_id = ""
client_id = ""
client_secret = ""   # Certificates & secrets → client secret VALUE (not its ID)

# Mailbox settings.
[exchange]
username = ""        # Fallback mailbox for drafts when no user is known (scripts)
cc = ""              # Optional: address CC'd on every RFQ email

# Branding + signature used in the email template.
[company]
name = ""
logo_url = ""
address = ""
sender_name = ""
sender_title = ""
sender_email = ""
sender_phone = ""

[app]
subject_prefix = ""  # e.g. "[RFQ]" — prepended to every email subject

# Box — file sharing and the shared data files. REQUIRED for Box features;
# without the *_ID keys the app falls back to local CSVs under docs/.
[box]
# Box Developer Console → your JWT app → Configuration → "Generate a
# Public/Private Keypair" downloads a JSON file. Paste its full contents here
# between the triple quotes.
BOX_JWT_JSON = '''
'''

# IDs are the number at the end of the Box URL (…/file/123456 or …/folder/123456).
# For each data file set the FILE_ID (preferred) or the FOLDER_ID it lives in.
BOX_QUEUE_FILE_ID = ""             # queue.csv — the RFQ queue
BOX_QUEUE_FOLDER_ID = ""
BOX_FAMILIAR_SPECS_FILE_ID = ""    # FamiliarSpecs.csv — Specs page
BOX_RFQ_MASTER_FILE_ID = ""        # rfq_master.csv — RFQ Master page / sent log
BOX_RFQ_MASTER_FOLDER_ID = ""
BOX_RFQ_RESPONSES_FILE_ID = ""     # rfq_responses.csv — vendor responses (future)
BOX_RFQ_RESPONSES_FOLDER_ID = ""
