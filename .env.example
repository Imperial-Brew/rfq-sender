# ─────────────────────────────────────────────────────────────────────────────
# RFQ Sender environment variables — TEMPLATE. Copy to .env and fill in.
# .env is git-ignored and loaded automatically when the API starts locally.
#
# On Render these are set in the dashboard instead:
#   Service → Environment → Environment Variables.
#
# Everything else (Azure/Graph, Box, company branding) lives in
# .streamlit/secrets.toml — see .streamlit/secrets.toml.example.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. Signs login tokens; the API refuses to start without it.
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
# Use a different value locally than on Render. Changing it logs everyone out.
JWT_SECRET_KEY=

# Optional. Path to the user list (default: users.yaml in the repo root).
# USERS_FILE=users.yaml

# Optional. Only needed if the React app is served from a different origin
# than the API (not the case on Render, where FastAPI serves the built app).
# FRONTEND_ORIGIN=https://example.com
