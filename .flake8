[flake8]
max-line-length = 100
extend-ignore = E203, W503
exclude = .git,__pycache__,build,dist,.venv
per-file-ignores =
    # Allow unused imports in __init__.py
    __init__.py: F401
    # Allow long lines in test files
    test_*.py: E501
    # Allow imports after sys.path modification in scripts
    scripts/*.py: E402